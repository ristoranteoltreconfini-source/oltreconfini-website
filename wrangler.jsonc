{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Versione nuova (senza fogli Google). Nome diverso dal sito attuale «oltreconfini»,
  // così si prova su oltreconfini-website.<account>.workers.dev senza toccare quello pubblicato.
  "name": "oltreconfini-website",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/dati/*", "/foto/*", "/pannello", "/pannello/*", "/_importa", "/_link", "/_stato"]
  },
  // pagina del pannello importata come testo
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  // tutti i dati: un Durable Object con database SQLite (creato nella giurisdizione UE)
  "durable_objects": { "bindings": [{ "name": "OLTRECONFINI", "class_name": "Oltreconfini" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Oltreconfini"] }],
  // ogni minuto: email in coda, ritardi delle prenotazioni, promemoria, pulizia notturna, copie di riserva
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "SITO": "https://oltreconfini.it/",
    "EMAIL_MITTENTE": "Oltreconfini <prenotazioni@oltreconfini.it>"
  },
  "observability": { "enabled": true },
  // il sito risponde su oltreconfini.it (www rimanda lì)
  "routes": [{ "pattern": "oltreconfini.it", "custom_domain": true }, { "pattern": "www.oltreconfini.it", "custom_domain": true }]
  // Segreti (wrangler secret put …, mai nel repository):
  //   OWNER_EMAIL     email del titolare (accesso completo al pannello)
  //   ADMIN_TOKEN     chiave per l'importazione iniziale e per ottenere il link del titolare
  //   GEMINI_API_KEY  IA del pannello (controlli e traduzioni)
  //   RESEND_API_KEY  invio delle email

}
